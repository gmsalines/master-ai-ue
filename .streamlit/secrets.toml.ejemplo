# Copiar como .streamlit/secrets.toml (local) o pegar en Streamlit Cloud -> Settings -> Secrets.
# NUNCA subir el archivo secrets.toml real al repositorio.

# IA (solo para aprender formatos nuevos a partir de un manual)
GROQ_API_KEY = "gsk_..."

# Usuarios, cruces guardados y memoria de configuración.
# Si estas dos claves no están, la app funciona en modo local (sin login; guarda en cruces_guardados/).
SUPABASE_URL = "https://<proyecto>.supabase.co"
SUPABASE_ANON_KEY = "sb_publishable_..."

# Mails que ven la configuración del modelo (proveedor, modelo, API key) en la barra lateral, separados por coma.
# El resto de los usuarios usa el modelo por defecto con la clave de arriba, sin verla.
ADMINS = "tu-mail@ejemplo.com"
