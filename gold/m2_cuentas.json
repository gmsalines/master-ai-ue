  "reglas": [
    {
      "id": "R1",
      "descripcion": "Saldo final = saldo inicial + créditos - débitos",
      "ambito": "registro",
      "tipo_registro": "CTA",
      "expresion": "saldo_final == saldo_inicial + total_creditos - total_debitos",
      "evidencia": "el saldo final debe ser igual al saldo inicial más el total de créditos menos el total de débitos"
    },
    {
      "id": "R2",
      "descripcion": "Total de créditos = suma de movimientos de crédito de la cuenta",
      "ambito": "registro",
      "tipo_registro": "CTA",
      "expresion": "total_creditos == sumar(\"MOV\", \"importe\", \"numero_cuenta\", numero_cuenta, \"tipo_movimiento\", \"C\")",
      "evidencia": "el total de créditos de la cuenta debe coincidir con la suma de los importes de los movimientos de crédito registrados en esa cuenta"
    },
    {
      "id": "R3",
      "descripcion": "Total de débitos = suma de movimientos de débito de la cuenta",
      "ambito": "registro",
      "tipo_registro": "CTA",
      "expresion": "total_debitos == sumar(\"MOV\", \"importe\", \"numero_cuenta\", numero_cuenta, \"tipo_movimiento\", \"D\")",
      "evidencia": "y el total de débitos con la suma de los importes de sus movimientos de débito"
    },
    {
      "id": "R4",
      "descripcion": "Los plazos fijos informan fecha de vencimiento",
      "ambito": "registro",
      "tipo_registro": "CTA",
      "expresion": "implica(tipo_cuenta == \"P\", not vacio(fecha_vencimiento))",
      "evidencia": "Es obligatoria para los depósitos a plazo fijo"
    },
    {
      "id": "R5",
      "descripcion": "Las cuentas que no son plazo fijo dejan la fecha de vencimiento en blanco",
      "ambito": "registro",
      "tipo_registro": "CTA",
      "expresion": "implica(tipo_cuenta != \"P\", vacio(fecha_vencimiento))",
      "evidencia": "debe dejarse en blanco para los demás tipos de cuenta"
    },
    {
      "id": "R6",
      "descripcion": "Cada movimiento corresponde a una cuenta informada",
      "ambito": "registro",
      "tipo_registro": "MOV",
      "expresion": "existe(\"CTA\", \"numero_cuenta\", numero_cuenta)",
      "evidencia": "Cada movimiento debe corresponder a una cuenta informada en un registro CTA del mismo archivo."
    },
    {
      "id": "R7",
      "descripcion": "El importe del movimiento es mayor que cero",
      "ambito": "registro",
      "tipo_registro": "MOV",
      "expresion": "importe > 0",
      "evidencia": "El importe de un movimiento debe ser siempre mayor que cero"
    },
    {
      "id": "R8",
      "descripcion": "La fecha de operación no es posterior a la fecha de corte",
      "ambito": "registro",
      "tipo_registro": "MOV",
      "expresion": "fecha_operacion <= valor(\"CAB\", \"fecha_corte\")",
      "evidencia": "ningún movimiento puede tener una fecha de operación posterior a la fecha de corte del encabezado"
    },
    {
      "id": "R9",
      "descripcion": "Cantidad de cuentas = cantidad de registros CTA",
      "ambito": "archivo",
      "tipo_registro": null,
      "expresion": "valor(\"TOT\", \"cantidad_cuentas\") == contar(\"CTA\")",
      "evidencia": "la cantidad de cuentas y la cantidad de movimientos deben coincidir con la cantidad de registros CTA y MOV del archivo"
    },
    {
      "id": "R10",
      "descripcion": "Cantidad de movimientos = cantidad de registros MOV",
      "ambito": "archivo",
      "tipo_registro": null,
      "expresion": "valor(\"TOT\", \"cantidad_movimientos\") == contar(\"MOV\")",
      "evidencia": "la cantidad de cuentas y la cantidad de movimientos deben coincidir con la cantidad de registros CTA y MOV del archivo"
    },
    {
      "id": "R11",
      "descripcion": "Suma de créditos = suma de total de créditos de las cuentas",
      "ambito": "archivo",
      "tipo_registro": null,
      "expresion": "valor(\"TOT\", \"suma_creditos\") == sumar(\"CTA\", \"total_creditos\")",
      "evidencia": "La suma de créditos debe ser igual a la suma del total de créditos de todas las cuentas"
    },
    {
      "id": "R12",
      "descripcion": "Suma de débitos = suma de total de débitos de las cuentas",
      "ambito": "archivo",
      "tipo_registro": null,
      "expresion": "valor(\"TOT\", \"suma_debitos\") == sumar(\"CTA\", \"total_debitos\")",
      "evidencia": "la suma de débitos igual a la suma del total de débitos de todas las cuentas"
    }
  ]
}