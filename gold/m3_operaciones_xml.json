  "reglas": [
    {
      "id": "R1",
      "descripcion": "Cantidad de operaciones del resumen = cantidad de elementos Operacion",
      "ambito": "archivo",
      "tipo_registro": null,
      "expresion": "valor(\"Resumen\", \"cantidad_operaciones\") == contar(\"Operacion\")",
      "evidencia": "la cantidad de operaciones del resumen coincida con la cantidad de elementos Operacion del documento"
    },
    {
      "id": "R2",
      "descripcion": "Monto total del resumen = suma de montos",
      "ambito": "archivo",
      "tipo_registro": null,
      "expresion": "valor(\"Resumen\", \"monto_total\") == sumar(\"Operacion\", \"monto\")",
      "evidencia": "el monto total del resumen sea igual a la suma de los montos de todas las operaciones"
    },
    {
      "id": "R3",
      "descripcion": "Monto mayor que cero",
      "ambito": "registro",
      "tipo_registro": "Operacion",
      "expresion": "monto > 0",
      "evidencia": "el monto de cada operación sea mayor que cero"
    },
    {
      "id": "R4",
      "descripcion": "Fecha de operación no posterior a la fecha de generación",
      "ambito": "registro",
      "tipo_registro": "Operacion",
      "expresion": "fecha_operacion <= valor(\"Cabecera\", \"fecha_generacion\")",
      "evidencia": "ninguna operación tenga una fecha posterior a la fecha de generación del reporte"
    },
    {
      "id": "R5",
      "descripcion": "Transferencias informan país e identificación de la contraparte",
      "ambito": "registro",
      "tipo_registro": "Operacion",
      "expresion": "implica(tipo_operacion == \"TRF\", not vacio(pais_contraparte) and not vacio(id_contraparte))",
      "evidencia": "en las transferencias se informen obligatoriamente el país y la identificación de la contraparte"
    },
    {
      "id": "R6",
      "descripcion": "Operaciones de cambio no usan moneda nacional",
      "ambito": "registro",
      "tipo_registro": "Operacion",
      "expresion": "implica(tipo_operacion == \"CAM\", moneda != \"MNL\")",
      "evidencia": "en las operaciones de cambio de divisas la moneda no sea la moneda nacional, cuyo código es MNL"
    }
