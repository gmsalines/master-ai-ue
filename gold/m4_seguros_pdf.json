  "reglas": [
    {
      "id": "R1",
      "descripcion": "Fin de vigencia posterior al inicio",
      "ambito": "registro",
      "tipo_registro": "PL",
      "expresion": "fecha_fin > fecha_inicio",
      "evidencia": "la fecha de fin de vigencia debe ser posterior a la fecha de inicio de vigencia"
    },
    {
      "id": "R2",
      "descripcion": "Prima mayor que cero",
      "ambito": "registro",
      "tipo_registro": "PL",
      "expresion": "prima > 0",
      "evidencia": "la prima emitida debe ser mayor que cero"
    },
    {
      "id": "R3",
      "descripcion": "Prima no supera la suma asegurada",
      "ambito": "registro",
      "tipo_registro": "PL",
      "expresion": "prima <= suma_asegurada",
      "evidencia": "en ningún caso podrá superar la suma asegurada"
    },
    {
      "id": "R4",
      "descripcion": "El siniestro corresponde a una póliza informada",
      "ambito": "registro",
      "tipo_registro": "SI",
      "expresion": "existe(\"PL\", \"numero_poliza\", numero_poliza)",
      "evidencia": "cada siniestro debe corresponder a una póliza informada en un registro PL del mismo archivo"
    },
    {
      "id": "R5",
      "descripcion": "Pagado no mayor que reclamado",
      "ambito": "registro",
      "tipo_registro": "SI",
      "expresion": "monto_pagado <= monto_reclamado",
      "evidencia": "El monto pagado no puede ser mayor que el monto reclamado"
    },
    {
      "id": "R6",
      "descripcion": "Rechazados con pago cero",
      "ambito": "registro",
      "tipo_registro": "SI",
      "expresion": "implica(estado == \"R\", monto_pagado == 0)",
      "evidencia": "los siniestros en estado rechazado deben informar un monto pagado igual a cero"
    },
    {
      "id": "R7",
      "descripcion": "Cantidad de pólizas",
      "ambito": "archivo",
      "tipo_registro": null,
      "expresion": "valor(\"TR\", \"cantidad_polizas\") == contar(\"PL\")",
      "evidencia": "la cantidad de pólizas y la cantidad de siniestros del registro TR deben coincidir con la cantidad de registros PL y SI"
    },
    {
      "id": "R8",
      "descripcion": "Cantidad de siniestros",
      "ambito": "archivo",
      "tipo_registro": null,
      "expresion": "valor(\"TR\", \"cantidad_siniestros\") == contar(\"SI\")",
      "evidencia": "la cantidad de pólizas y la cantidad de siniestros del registro TR deben coincidir con la cantidad de registros PL y SI"
    },
    {
      "id": "R9",
      "descripcion": "Total de primas",
      "ambito": "archivo",
      "tipo_registro": null,
      "expresion": "valor(\"TR\", \"total_primas\") == sumar(\"PL\", \"prima\")",
      "evidencia": "El total de primas debe ser igual a la suma de las primas emitidas de todas las pólizas"
    },
    {
      "id": "R10",
      "descripcion": "Total pagado",
      "ambito": "archivo",
      "tipo_registro": null,
      "expresion": "valor(\"TR\", \"total_pagado\") == sumar(\"SI\", \"monto_pagado\")",
      "evidencia": "el total pagado igual a la suma de los montos pagados de todos los siniestros"
    }
  ]
